# Copy to .env in the project root. The project root is $TRAVELDESK_HOME
# (set in the environment, e.g. the launchd plist) or else the current folder.

# ── Slack (api.slack.com/apps → your app) ─────────────────────────────
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_APP_TOKEN=xapp-REPLACE_ME

# ── Claude (console.anthropic.com → API keys) ────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Routing model IDs — change only when Anthropic publishes a newer release.
# Haiku handles routine tasks (intent, airport lookup, data extraction,
# formatting); Sonnet handles complex itineraries, multi-city, ambiguous
# requests and recovery.
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_SONNET_MODEL=claude-sonnet-5

# ── LetsFG Developer REST API key (letsfg.co → developers) ───────────
# LETSFG_TOKEN is also accepted for existing setups.
LETSFG_API_KEY=letsfg_REPLACE_ME

# ── Booking rules ────────────────────────────────────────────────────
CURRENCY=INR
BOOKING_RULE=Pick the cheapest nonstop economy flight inside the requested time window. If there is no nonstop, pick the cheapest one-stop flight with total journey under 6 hours.
# Hard cap per person; leave empty for no cap
MAX_PRICE=15000
# true = search and pick only, never actually book (use for testing)
DRY_RUN=true

# Slack member IDs (comma-separated) told when a booking needs a human, e.g.
# LetsFG still refuses after the traveller added passport details.
TRAVEL_ADMIN_SLACK_IDS=
# Travel admins are also the only people who can book for others
# (/traveldesk … for @asha @ravi — the group booking flow).
# Who gets the "Pay now" link when the card is declined and LetsFG offers a
# secure payment page (Slack member IDs, comma-separated). Empty = traveller.
PAYMENT_APPROVER_SLACK_IDS=
# Fallback lifetime of a pay link when LetsFG doesn't say (minutes)
PAY_LINK_TIMEOUT_MINUTES=60
# "I don't have a passport": show other flights departing within ± this many hours
ALT_WINDOW_HOURS=3

# How long to keep checking for the ticket after booking starts
POLL_SECONDS=45
POLL_MAX_MINUTES=30
# One "heartbeat" line in bot.log this often (seconds; 0 = off)
HEARTBEAT_SECONDS=300

# Where SQLite lives (relative paths are under the project root)
DATABASE_PATH=traveldesk.db

# Fernet key that encrypts passport/DOB data at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRAVELDESK_DATA_KEY=

# --- Ops layer (traveldesk.ops) ---
# SQLAlchemy URL for the ops_* tables. Empty = the SQLite file above (DATABASE_PATH),
# next to the bot's own tables. Later: postgresql+psycopg://user:pass@host/traveldesk
OPS_DATABASE_URL=
# Booking supplier behind the Supplier interface: letsfg (live) | tbo (stub until credentials)
SUPPLIER=letsfg
# Channel for ops alerts and the daily digest (name like #travel-ops, or its ID C…).
# Invite the bot to it: /invite @TravelDesk
OPS_SLACK_CHANNEL=#travel-ops
# Watchdog: how often it runs, and what counts as worth telling someone
WATCHDOG_INTERVAL_HOURS=3
FARE_DROP_THRESHOLD_PAISE=50000
SCHEDULE_DRIFT_MINUTES=20
# End-of-day leakage digest (posted to OPS_SLACK_CHANNEL)
DIGEST_TIME_IST=19:00
REFUND_PENDING_MAX_DAYS=7
# Your company's GSTIN: invoices billed to any other GSTIN are flagged (empty = only check validity)
COMPANY_GSTIN=
# GST: your state code (e.g. 27); empty = first two digits of COMPANY_GSTIN. Same state as the supplier
# → CGST+SGST, else IGST. Without COMPANY_GSTIN, GST is still computed but ITC shows "n/a".
COMPANY_STATE_CODE=
# Dashboard base URL for [Open booking] buttons (empty = no button), e.g. http://mac-mini.local:5173
DASHBOARD_URL=
# Ledger: a booking-time (charged) debit with no ticket after this → digest "Charged, no ticket"
# (also when a pending group traveller is moved to "needs action"). e.g. 90m, 2h, 1h30m
TICKET_TIMEOUT=2h
# An unpaid supplier pay link older than this → digest "Awaiting payment"
AWAITING_PAYMENT_ALERT=30m
# Group booking: per_traveller = re-search and book a fresh offer per traveller (default);
# shared = book the one picked offer for everyone (only once LetsFG confirms offers can be reused)
GROUP_OFFER_MODE=per_traveller
# A re-priced fare may rise this much (%) and stay within MAX_PRICE and still book without asking
PRICE_TOLERANCE_PCT=5
