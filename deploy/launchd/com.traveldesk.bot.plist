<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.traveldesk.bot</string>
  <!-- Change YOURUSER to your macOS username -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOURUSER/traveldesk-bot/.venv/bin/python</string>
    <string>/Users/YOURUSER/traveldesk-bot/app.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOURUSER/traveldesk-bot</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOURUSER/traveldesk-bot/bot.log</string>
  <key>StandardErrorPath</key><string>/Users/YOURUSER/traveldesk-bot/bot.log</string>
</dict>
</plist>
