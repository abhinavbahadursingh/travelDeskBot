  <array>
    <string>/Users/rgl/Downloads/traveldesk-bot/.venv/bin/python</string>
    <string>-m</string>
    <string>traveldesk.ops.scheduler</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/rgl/Downloads/traveldesk-bot</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key><string>/Users/rgl/Downloads/traveldesk-bot/src</string>
