<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.traveldesk.ops</string>
  <!-- If the project moves, update every /Users/rgl/Downloads/traveldesk-bot path below.
       Install: cp deploy/launchd/com.traveldesk.ops.plist ~/Library/LaunchAgents/
                launchctl load ~/Library/LaunchAgents/com.traveldesk.ops.plist -->
